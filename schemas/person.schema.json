{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "string"
    },
    "links": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "label",
          "url"
        ]
      }
    },
    "name": {
      "type": "string"
    },
    "profileUrl": {
      "type": "string",
      "format": "uri"
    },
    "published": {
      "default": true,
      "type": "boolean"
    },
    "sortName": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "sortName"
  ],
  "additionalProperties": false,
  "$id": "https://www.xedotnet.org/schemas/person.schema.json",
  "title": "XeDotNet public profile"
}
