{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string"
      },
      "imageHeight": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "imageWidth": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "kind": {
        "type": "string",
        "enum": [
          "sponsor",
          "supporter"
        ]
      },
      "name": {
        "type": "string"
      },
      "order": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "published": {
        "default": true,
        "type": "boolean"
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "id": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "kind",
      "name",
      "url",
      "id"
    ]
  },
  "$id": "https://www.xedotnet.org/schemas/partners.schema.json",
  "title": "Partner XeDotNet"
}
