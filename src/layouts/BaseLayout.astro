---
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const { title, description, image = '/images/social-card.svg', type = 'website', structuredData } = Astro.props,
 [site] = await getCollection('site'),
 canonicalPath = Astro.url.pathname === withBase('/404/') ? withBase('/404.html') : Astro.url.pathname,
 canonical = new URL(canonicalPath, Astro.site),
 fullTitle = title === site.data.name ? title : `${title} | ${site.data.name}`,
 fullImage = new URL(withBase(image), Astro.site),
 organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  address: site.data.address,
  email: site.data.email,
  name: site.data.name,
  sameAs: site.data.socials.map((social) => social.url),
  url: new URL(withBase('/'), Astro.site).href
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f8f9" />
    {import.meta.env.PUBLIC_NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <ThemeScript />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/images/favicon/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="96x96" href={withBase('/images/favicon/favicon-96x96.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/images/favicon/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/images/favicon/apple-icon-180x180.png')} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData ?? organization)} />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header navigation={site.data.navigation} />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer site={site.data} />
  </body>
</html>
