<script>
  import { withBase } from '../lib/urls';
  import {
    fetchWebMcpJson,
    listMembers,
    memberForSlug,
    registerWebMcpTools,
  } from '../lib/webmcp';
  import { isMemberCatalog, isMemberDetails } from '../lib/webmcp-data';
  import { memberResponse } from '../lib/webmcp-queries';
  import { assertNoUnsavedForms } from '../lib/webmcp-runtime';

  function loadCatalog(signal: AbortSignal) {
    return fetchWebMcpJson(withBase('/webmcp/members.json'), isMemberCatalog, signal);
  }
  const slugProperty = { type: 'string', description: 'Slug esatto restituito dalla ricerca dei soci.' } as const;

  registerWebMcpTools([
    {
      name: 'list_members',
      title: 'Cerca soci XE',
      description: 'Cerca i soci attuali pubblicati da XeDotNet. Usa questo strumento per trovare una persona per nome, attività o ruolo.',
      inputSchema: {
        type: 'object',
        properties: {
          query: { type: 'string', description: 'Testo da cercare nel nome, nel titolo o nella biografia.' },
          role: { type: 'string', enum: ['member', 'speaker', 'both'], description: 'Soci, relatori tra i soci, oppure entrambi.' },
          offset: { type: 'integer', minimum: 0, description: 'Indice da cui continuare una ricerca precedente.' },
        },
        additionalProperties: false,
      },
      async execute(input, { signal }) {
        return listMembers(await loadCatalog(signal), input);
      },
      annotations: { readOnlyHint: true, untrustedContentHint: true },
    },
    {
      name: 'get_member',
      title: 'Leggi un profilo XE',
      description: 'Legge il profilo di un socio XE. Usa questo strumento per approfondire biografia, ruoli e collegamenti di una persona trovata.',
      inputSchema: {
        type: 'object',
        properties: {
          slug: slugProperty,
          section: { type: 'string', enum: ['overview', 'biography', 'links'], description: 'Panoramica, biografia o collegamenti. La panoramica è la sezione iniziale.' },
          offset: { type: 'integer', minimum: 0, description: 'Posizione da cui continuare: caratteri per la biografia, elementi per i collegamenti.' },
        },
        required: ['slug'],
        additionalProperties: false,
      },
      async execute(input, { signal }) {
        const member = memberForSlug(await loadCatalog(signal), input.slug);
        const details = await fetchWebMcpJson(withBase(`/webmcp/members/${member.slug}.json`), isMemberDetails, signal);
        return memberResponse(details, input);
      },
      annotations: { readOnlyHint: true, untrustedContentHint: true },
    },
    {
      name: 'open_member',
      title: 'Apri un socio XE',
      description: 'Apre la pagina di un socio XE. Usa questo strumento quando l’utente vuole vedere il profilo nel browser.',
      inputSchema: {
        type: 'object', properties: { slug: slugProperty }, required: ['slug'], additionalProperties: false,
      },
      async execute({ slug }, { signal }) {
        assertNoUnsavedForms();
        const member = memberForSlug(await loadCatalog(signal), slug);
        signal.throwIfAborted();
        assertNoUnsavedForms();
        // Stay on the active deployment, including local and preview origins.
        window.location.assign(new URL(member.url).pathname);
        return { status: 'navigating' };
      },
    },
  ]);
</script>
