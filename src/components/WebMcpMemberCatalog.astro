---
import type { WebMcpMemberSummary } from '../lib/webmcp';
import { withBase } from '../lib/urls';

interface Props {
  members: WebMcpMemberSummary[];
}

const catalogUrl = withBase('/webmcp/members.json');
const allowedSlugs = JSON.stringify(Astro.props.members.map(({ slug }) => slug));
---

<span hidden data-webmcp-member-catalog data-url={catalogUrl} data-allowed-slugs={allowedSlugs}></span>

<script>
  import {
    fetchWebMcpJson,
    listMembers,
    memberForSlug,
    registerWebMcpTools,
    type WebMcpMemberSummary,
  } from '../lib/webmcp';
  const catalogElement = document.querySelector<HTMLElement>(
      '[data-webmcp-member-catalog]',
    ),
    catalogUrl = catalogElement?.dataset.url,
    allowedSlugs = (() => {
      try {
        const value: unknown = JSON.parse(catalogElement?.dataset.allowedSlugs ?? '');
        return Array.isArray(value) && value.every((slug) => typeof slug === 'string')
          ? value as string[]
          : undefined;
      } catch {
        return undefined;
      }
    })(),
    loadCatalog = () => {
      if (!catalogUrl) {
        throw new Error('Il catalogo dei soci non è disponibile.');
      }
      return fetchWebMcpJson(catalogUrl, (value): value is WebMcpMemberSummary[] => Array.isArray(value));
    },
    listSchema = {
      type: 'object',
      properties: {
        query: {
          type: 'string',
          description:
            'Testo da cercare nel nome, nel titolo o nell’estratto della biografia.',
        },
        role: {
          type: 'string',
          enum: ['member', 'speaker', 'both'],
          description:
            'Ruolo da filtrare. "both" include soci e relatori insieme.',
        },
        offset: {
          type: 'integer',
          minimum: 0,
          description: 'Indice da cui continuare una ricerca precedente.',
        },
      },
      additionalProperties: false,
    } as const,
    openSchema = {
      type: 'object',
      properties: {
        slug: {
          type: 'string',
          description: 'Slug esatto restituito da list_members.',
        },
      },
      required: ['slug'],
      additionalProperties: false,
    } as const;

  if (catalogUrl && allowedSlugs) {
    registerWebMcpTools([
      {
        name: 'list_members',
        title: 'Cerca soci XE',
        description:
          'Cerca i soci pubblicati da XeDotNet. Restituisce fino a cinque risultati alla volta con `nextOffset`; quando `nextOffset` è `null` la ricerca è terminata.',
        inputSchema: listSchema,
        async execute(input) {
          const catalog = await loadCatalog();
          return listMembers(
            catalog.filter((member) => allowedSlugs.includes(member.slug)),
            input,
          );
        },
        annotations: { readOnlyHint: true },
      },
      {
        name: 'open_member',
        title: 'Apri un socio XE',
        description:
          'Apre nel browser la pagina del socio restituito da list_members.',
        inputSchema: openSchema,
        async execute({ slug }, { signal }) {
          signal.throwIfAborted();
          const catalog = (await loadCatalog()).filter((member) =>
            allowedSlugs.includes(member.slug),
          );
          signal.throwIfAborted();
          const member = memberForSlug(catalog, slug);
          window.location.assign(member.url);
          return `Navigazione verso “${member.name}”.`;
        },
        annotations: { readOnlyHint: true },
      },
    ]);
  }
</script>
