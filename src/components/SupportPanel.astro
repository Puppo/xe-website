---
import { externalLinkProps, isExternalUrl } from '../lib/urls';

interface Props { membershipButtonId: string; donationButtonId: string }
const { membershipButtonId, donationButtonId } = Astro.props,
 membershipUrl = `https://www.paypal.com/cgi-bin/webscr?${new URLSearchParams({ cmd: '_s-xclick', hosted_button_id: membershipButtonId })}`,
 donationUrl = `https://www.paypal.com/cgi-bin/webscr?${new URLSearchParams({ cmd: '_s-xclick', hosted_button_id: donationButtonId })}`,
 siteOrigin = Astro.site?.origin;
---

<section class="support-panel">
  <div>
    <h2>Costruiamo XE insieme</h2>
    <p>La quota associativa annuale di 50 € mantiene gratuiti gli eventi e sostiene le attività della community.</p>
    <ul>
      <li>Gruppo privato su Slack</li>
      <li>Accesso anticipato agli eventi con posti limitati</li>
      <li>Profilo pubblico sul sito</li>
      <li>Gadget di benvenuto</li>
    </ul>
  </div>
  <div class="support-actions">
    <a href={membershipUrl} {...externalLinkProps(membershipUrl, siteOrigin)}>
      <span class="support-link-copy"><span class="support-link-label">Diventa socio</span>{' '}<span class="support-link-provider">su PayPal</span></span>
      <span class="support-link-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7M21 3l-9 9M10 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" /></svg></span>
      {isExternalUrl(membershipUrl, siteOrigin) && <span class="visually-hidden"> (si apre in una nuova scheda)</span>}
    </a>
    <a href={donationUrl} {...externalLinkProps(donationUrl, siteOrigin)}>
      <span class="support-link-copy"><span class="support-link-label">Fai una donazione</span>{' '}<span class="support-link-provider">su PayPal</span></span>
      <span class="support-link-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7M21 3l-9 9M10 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" /></svg></span>
      {isExternalUrl(donationUrl, siteOrigin) && <span class="visually-hidden"> (si apre in una nuova scheda)</span>}
    </a>
    <p class="form-note">IBAN: <span class="nowrap">IT47 E084 5236 1800 0000 0109 908</span></p>
  </div>
</section>
