---
import { externalLinkProps, isExternalUrl } from '../lib/urls';

interface Props { membershipButtonId: string; donationButtonId: string }
const { membershipButtonId, donationButtonId } = Astro.props,
 membershipUrl = `https://www.paypal.com/cgi-bin/webscr?${new URLSearchParams({ cmd: '_s-xclick', hosted_button_id: membershipButtonId })}`,
 donationUrl = `https://www.paypal.com/cgi-bin/webscr?${new URLSearchParams({ cmd: '_s-xclick', hosted_button_id: donationButtonId })}`,
 siteOrigin = Astro.site?.origin;
---

<section class="support-panel">
  <div>
    <h2>Costruiamo XE insieme</h2>
    <p>La quota associativa annuale di 50 € mantiene gratuiti gli eventi e sostiene le attività della community.</p>
    <ul>
      <li>Gruppo privato su Slack</li>
      <li>Accesso anticipato agli eventi con posti limitati</li>
      <li>Profilo pubblico sul sito</li>
      <li>Gadget di benvenuto</li>
    </ul>
  </div>
  <div class="support-actions">
    <a href={membershipUrl} {...externalLinkProps(membershipUrl, siteOrigin)}>Diventa socio su PayPal&nbsp;<span aria-hidden="true">↗</span>{isExternalUrl(membershipUrl, siteOrigin) && <span class="visually-hidden"> (si apre in una nuova scheda)</span>}</a>
    <a href={donationUrl} {...externalLinkProps(donationUrl, siteOrigin)}>Fai una donazione su PayPal&nbsp;<span aria-hidden="true">↗</span>{isExternalUrl(donationUrl, siteOrigin) && <span class="visually-hidden"> (si apre in una nuova scheda)</span>}</a>
    <p class="form-note">IBAN: <span class="nowrap">IT47 E084 5236 1800 0000 0109 908</span></p>
  </div>
</section>
