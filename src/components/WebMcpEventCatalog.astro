<script>
  import { withBase } from '../lib/urls';
  import {
    fetchWebMcpJson,
    eventForSlug,
    listEvents,
    registerWebMcpTools,
    type WebMcpFullEvent,
  } from '../lib/webmcp';

  import { isEventCatalog } from '../lib/webmcp-data';
  import { eventResponse, searchEventMaterials } from '../lib/webmcp-queries';
  import { assertNoUnsavedForms } from '../lib/webmcp-runtime';

  function loadCatalog(signal: AbortSignal): Promise<WebMcpFullEvent[]> {
    return fetchWebMcpJson(withBase('/webmcp/events.json'), isEventCatalog, signal);
  }

  registerWebMcpTools([
    {
      name: 'list_events',
      title: 'Cerca eventi XE',
      description:
        'Cerca gli eventi pubblicati da XeDotNet, anche passati e annullati. Usa questo strumento per trovare incontri per argomento, periodo o relatore.',
      inputSchema: {
        type: 'object',
        properties: {
          query: { type: 'string', description: 'Testo da cercare in titolo, descrizione, tipo, luogo e relatori.' },
          dateFrom: { type: 'string', pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}$', description: 'Primo giorno incluso, nel formato YYYY-MM-DD.' },
          dateTo: { type: 'string', pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}$', description: 'Ultimo giorno incluso, nel formato YYYY-MM-DD.' },
          title: { type: 'string', description: 'Testo da cercare solo nel titolo.' },
          description: { type: 'string', description: 'Testo da cercare solo nella descrizione.' },
          speakers: { type: 'array', minItems: 1, items: { type: 'string', minLength: 1 }, description: 'Uno o più nomi di relatori; basta una corrispondenza.' },
          year: { type: 'integer', description: 'Anno solare degli eventi da mostrare.' },
          period: { type: 'string', enum: ['all', 'upcoming', 'past'], description: 'Periodo: tutti, futuri o passati.' },
          offset: { type: 'integer', minimum: 0, description: 'Indice da cui continuare una ricerca precedente.' },
        },
        additionalProperties: false,
      },
      async execute(input, { signal }) {
        return listEvents(await loadCatalog(signal), input);
      },
      annotations: { readOnlyHint: true, untrustedContentHint: true },
    },
    {
      name: 'get_event',
      title: 'Dettagli di un evento XE',
      description:
        'Legge un evento XE e la disponibilità attuale delle iscrizioni. Usa questo strumento per approfondire un evento trovato o leggere contenuto, programma e materiali.',
      inputSchema: {
        type: 'object',
        properties: {
          slug: { type: 'string', description: 'Slug esatto restituito dalla ricerca degli eventi.' },
          section: { type: 'string', enum: ['overview', 'body', 'sessions', 'materials'], description: 'Panoramica, contenuto, programma o materiali. La panoramica è la sezione iniziale.' },
          offset: { type: 'integer', minimum: 0, description: 'Posizione da cui continuare: caratteri per il contenuto, elementi per le altre sezioni.' },
        },
        required: ['slug'],
        additionalProperties: false,
      },
      async execute(input, { signal }) {
        return eventResponse(await loadCatalog(signal), input);
      },
      annotations: { readOnlyHint: true, untrustedContentHint: true },
    },
    {
      name: 'open_event',
      title: 'Apri un evento XE',
      description: 'Apre la pagina di un evento XE. Usa questo strumento quando l’utente vuole vedere l’evento nel browser.',
      inputSchema: {
        type: 'object',
        properties: { slug: { type: 'string', description: 'Slug esatto restituito da list_events.' } },
        required: ['slug'],
        additionalProperties: false,
      },
      async execute({ slug }, { signal }) {
        assertNoUnsavedForms();
        const event = eventForSlug(await loadCatalog(signal), slug);
        signal.throwIfAborted();
        assertNoUnsavedForms();
        // Stay on the active deployment, including local and preview origins.
        window.location.assign(new URL(event.url).pathname);
        return { status: 'navigating' };
      },
    },
    {
      name: 'search_event_materials',
      title: 'Cerca materiali degli eventi XE',
      description: 'Trova slide e risorse degli eventi XE. Usa questo strumento per cercare materiali per argomento o leggere quelli di un evento specifico.',
      inputSchema: {
        type: 'object',
        properties: {
          query: { type: 'string', description: 'Argomento cercato nei materiali, negli eventi e nelle sessioni.' },
          eventSlug: { type: 'string', description: 'Slug dell’evento a cui limitare la ricerca.' },
          offset: { type: 'integer', minimum: 0, description: 'Indice da cui continuare la ricerca.' },
        },
        additionalProperties: false,
      },
      async execute(input, { signal }) {
        return searchEventMaterials(await loadCatalog(signal), input);
      },
      annotations: { readOnlyHint: true, untrustedContentHint: true },
    },
  ]);
</script>
