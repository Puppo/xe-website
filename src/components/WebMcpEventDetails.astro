---
import { withBase } from '../lib/urls';

interface Props {
  slug: string;
}

const detailsUrl = withBase(`/webmcp/events/${Astro.props.slug}.json`);
---

<span hidden data-webmcp-event-details data-url={detailsUrl}></span>

<script>
  import {
    describeEvent,
    fetchWebMcpJson,
    registerWebMcpTools,
    type WebMcpEventDetails,
  } from '../lib/webmcp';

  const detailsElement = document.querySelector<HTMLElement>(
      '[data-webmcp-event-details]',
    ),
    detailsUrl = detailsElement?.dataset.url;

  if (detailsUrl) {
    registerWebMcpTools([
      {
        name: 'describe_event',
        title: 'Descrivi questo evento XE',
        description:
          'Restituisce una descrizione compatta dell’evento XE aperto, con programma, relatori, iscrizione e materiali.',
        inputSchema: {
          type: 'object',
          properties: {},
          additionalProperties: false,
        },
        async execute() {
          const details = await fetchWebMcpJson(
            detailsUrl,
            (value): value is WebMcpEventDetails =>
              typeof value === 'object' && value !== null && 'title' in value,
          );
          return describeEvent(details);
        },
        annotations: { readOnlyHint: true },
      },
    ]);
  }
</script>
