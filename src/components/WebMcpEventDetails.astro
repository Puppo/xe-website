---
import { withBase } from '../lib/urls';

interface Props {
  slug: string;
}

const detailsUrl = withBase(`/webmcp/events/${Astro.props.slug}.json`);
---

<span hidden data-webmcp-event-details data-url={detailsUrl}></span>

<script>
  import {
    describeEvent,
    fetchWebMcpJson,
    registerWebMcpTools,
  } from '../lib/webmcp';

  import { isEventDetails } from '../lib/webmcp-data';

  const detailsElement = document.querySelector<HTMLElement>(
      '[data-webmcp-event-details]',
    ),
    detailsUrl = detailsElement?.dataset.url;

  if (detailsUrl) {
    registerWebMcpTools([
      {
        name: 'describe_event',
        title: 'Descrivi questo evento XE',
        description:
          'Descrive l’evento XE aperto e le iscrizioni attuali. Usa questo strumento quando l’utente chiede informazioni su questa pagina.',
        inputSchema: {
          type: 'object',
          properties: {},
          additionalProperties: false,
        },
        async execute(_input, { signal }) {
          const details = await fetchWebMcpJson(
            detailsUrl,
            isEventDetails,
            signal,
          );
          return describeEvent(details);
        },
        annotations: { readOnlyHint: true, untrustedContentHint: true },
      },
    ]);
  }
</script>
