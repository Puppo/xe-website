---
import { withBase } from '../lib/urls';
interface Props {
  navigation: Array<{ label: string; href: string }>;
}
const { navigation } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label="XeDotNet, pagina iniziale">
      <img class="brand-logo" src={withBase('/images/xe-logo-original.png')} alt="XE" width="162" height="97" />
    </a>
    <div class="nav-area" data-nav-area>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Apri il menu</span>
        <span class="menu-icon icon-mask" style={`--icon-url: url(${withBase('/images/icons/menu.svg')})`} aria-hidden="true"></span>
      </button>
      <nav id="primary-navigation" aria-label="Principale">
        <ul class="nav-list" role="list">
          {navigation.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={currentPath.startsWith(withBase(item.href)) && item.href !== '/' || currentPath === withBase(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="theme-control" data-theme-preference="system" hidden>
      <label class="visually-hidden" for="theme">Tema</label>
      <div class="theme-picker">
        <span class="theme-icons" aria-hidden="true">
          <span class="theme-icon icon-mask" data-theme-icon="system" style={`--icon-url: url(${withBase('/images/icons/theme-system.svg')})`}></span>
          <span class="theme-icon icon-mask" data-theme-icon="light" style={`--icon-url: url(${withBase('/images/icons/theme-light.svg')})`}></span>
          <span class="theme-icon icon-mask" data-theme-icon="dark" style={`--icon-url: url(${withBase('/images/icons/theme-dark.svg')})`}></span>
        </span>
        <span class="theme-value" aria-hidden="true">Sistema</span>
        <span class="theme-chevron icon-mask" style={`--icon-url: url(${withBase('/images/icons/chevron-down.svg')})`} aria-hidden="true"></span>
        <select id="theme" name="theme">
          <option value="system">Sistema</option>
          <option value="light">Chiaro</option>
          <option value="dark">Scuro</option>
        </select>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileNavigation = window.matchMedia('(max-width: 48rem)');

  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const area = header.querySelector<HTMLElement>('[data-nav-area]');
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const label = header.querySelector<HTMLElement>('[data-menu-label]');
    const navigation = header.querySelector<HTMLElement>('#primary-navigation');
    if (!area || !toggle || !label || !navigation) return;

    area.dataset.menuReady = '';

    const setOpen = (open: boolean, restoreFocus = false) => {
      area.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Chiudi il menu' : 'Apri il menu';
      if (!open && restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    navigation.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (mobileNavigation.matches && !header.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false, true);
      }
    });

    mobileNavigation.addEventListener('change', () => setOpen(false));
  });
</script>
