---
import { withBase } from '../lib/urls';
interface Props {
  navigation: Array<{ label: string; href: string }>;
}
const { navigation } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label="XeDotNet, pagina iniziale">
      <img class="brand-logo" src={withBase('/images/xe-logo-original.png')} alt="XE" width="162" height="97" />
      <span class="brand-name">Development user group</span>
    </a>
    <div class="nav-area" data-nav-area>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Apri il menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="5" r="2"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <circle cx="12" cy="19" r="2"></circle>
        </svg>
      </button>
      <nav id="primary-navigation" aria-label="Principale">
        <ul class="nav-list" role="list">
          {navigation.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={currentPath.startsWith(withBase(item.href)) && item.href !== '/' || currentPath === withBase(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="theme-control" data-theme-preference="system" hidden>
      <label for="theme">Tema</label>
      <div class="theme-picker">
        <span class="theme-icons" aria-hidden="true">
          <svg class="theme-icon" data-theme-icon="system" viewBox="0 0 24 24" focusable="false">
            <rect x="3.5" y="4.5" width="17" height="12" rx="2"></rect>
            <path d="M8 20h8M12 16.5V20"></path>
          </svg>
          <svg class="theme-icon" data-theme-icon="light" viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
          </svg>
          <svg class="theme-icon" data-theme-icon="dark" viewBox="0 0 24 24" focusable="false">
            <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8a8.5 8.5 0 1 0 11.3 11.3Z"></path>
          </svg>
        </span>
        <span class="theme-value" aria-hidden="true">Sistema</span>
        <svg class="theme-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="m4 6 4 4 4-4"></path>
        </svg>
        <select id="theme" name="theme">
          <option value="system">Sistema</option>
          <option value="light">Chiaro</option>
          <option value="dark">Scuro</option>
        </select>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileNavigation = window.matchMedia('(max-width: 48rem)');

  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const area = header.querySelector<HTMLElement>('[data-nav-area]');
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const label = header.querySelector<HTMLElement>('[data-menu-label]');
    const navigation = header.querySelector<HTMLElement>('#primary-navigation');
    if (!area || !toggle || !label || !navigation) return;

    area.dataset.menuReady = '';

    const setOpen = (open: boolean, restoreFocus = false) => {
      area.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Chiudi il menu' : 'Apri il menu';
      if (!open && restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    navigation.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (mobileNavigation.matches && !header.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false, true);
      }
    });

    mobileNavigation.addEventListener('change', () => setOpen(false));
  });
</script>
