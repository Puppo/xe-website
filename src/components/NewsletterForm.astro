---
import { withBase } from '../lib/urls';

interface Props { action: string; honeypot: string }
const { action, honeypot } = Astro.props;
---

<form class="newsletter" action={action} method="post" data-newsletter-form>
  <h2>Newsletter</h2>
  <p id="newsletter-help">Ricevi soltanto aggiornamenti sulle attività di XE.</p>
  <div class="form-row">
    <div class="field">
      <label for="newsletter-email">Email <span aria-hidden="true">*</span></label>
      <input id="newsletter-email" name="EMAIL" type="email" inputmode="email" autocomplete="email" spellcheck="false" aria-describedby="newsletter-help" maxlength="254" required />
    </div>
    <button type="submit">Iscriviti</button>
  </div>
  <div class="honeypot" aria-hidden="true">
    <label for="newsletter-check">Lascia vuoto questo campo</label>
    <input id="newsletter-check" name={honeypot} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="form-note">Iscrivendoti accetti il trattamento descritto nell’<a href={withBase('/privacy-policy/')}>informativa sulla privacy</a>.</p>
</form>

<script>
  import { registerWebMcpTools, requiredString } from '../lib/webmcp';
  import { prepareForm } from '../lib/webmcp-runtime';

  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]'),
    emailInput = form?.querySelector<HTMLInputElement>('[name="EMAIL"]'),
    submitButton = form?.querySelector<HTMLButtonElement>('[type="submit"]');

  if (form && emailInput && submitButton) {
    registerWebMcpTools([
      {
        name: 'prepare_newsletter_subscription',
        title: 'Prepara l’iscrizione alla newsletter',
        description:
          'Prepara il modulo newsletter XE per la revisione e l’invio manuale. Usa questo strumento quando l’utente vuole iscriversi agli aggiornamenti.',
        inputSchema: {
          type: 'object',
          properties: {
            email: {
              type: 'string',
              format: 'email',
              maxLength: 254,
              description: 'Indirizzo email da iscrivere alla newsletter.',
            },
          },
          required: ['email'],
          additionalProperties: false,
        },
        async execute(input, { signal }) {
          const email = requiredString(input, 'email');
          await prepareForm(
            form,
            [{ control: emailInput, value: email }],
            submitButton,
            signal,
          );
          return {
            status: 'requires_user_action',
            message: 'Modulo newsletter compilato. Controlla l’indirizzo e premi “Iscriviti” per inviarlo.',
          };
        },
      },
    ]);
  }
</script>
