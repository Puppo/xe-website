---
import { withBase } from '../lib/urls';

interface Props {
  slug: string;
}

const detailsUrl = withBase(`/webmcp/members/${Astro.props.slug}.json`);
---

<span hidden data-webmcp-member-details data-url={detailsUrl}></span>

<script>
  import {
    describeMember,
    fetchWebMcpJson,
    registerWebMcpTools,
    type WebMcpMemberDetails,
  } from '../lib/webmcp';

  const detailsElement = document.querySelector<HTMLElement>(
      '[data-webmcp-member-details]',
    ),
    detailsUrl = detailsElement?.dataset.url;

  if (detailsUrl) {
    registerWebMcpTools([
      {
        name: 'describe_member',
        title: 'Descrivi questo socio XE',
        description:
          'Restituisce una descrizione compatta del socio XE aperto, con ruolo, biografia e collegamenti.',
        inputSchema: {
          type: 'object',
          properties: {},
          additionalProperties: false,
        },
        async execute() {
          const details = await fetchWebMcpJson(
            detailsUrl,
            (value): value is WebMcpMemberDetails =>
              typeof value === 'object' && value !== null && 'name' in value,
          );
          return describeMember(details);
        },
        annotations: { readOnlyHint: true },
      },
    ]);
  }
</script>
