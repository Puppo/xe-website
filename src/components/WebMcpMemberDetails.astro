---
import { withBase } from '../lib/urls';

interface Props {
  slug: string;
}

const detailsUrl = withBase(`/webmcp/members/${Astro.props.slug}.json`);
---

<span hidden data-webmcp-member-details data-url={detailsUrl}></span>

<script>
  import {
    describeMember,
    fetchWebMcpJson,
    registerWebMcpTools,
  } from '../lib/webmcp';

  import { isMemberDetails } from '../lib/webmcp-data';

  const detailsElement = document.querySelector<HTMLElement>(
      '[data-webmcp-member-details]',
    ),
    detailsUrl = detailsElement?.dataset.url;

  if (detailsUrl) {
    registerWebMcpTools([
      {
        name: 'describe_member',
        title: 'Descrivi questo socio XE',
        description:
          'Descrive il socio XE aperto, con ruolo, biografia e collegamenti. Usa questo strumento quando l’utente chiede informazioni su questa persona.',
        inputSchema: {
          type: 'object',
          properties: {},
          additionalProperties: false,
        },
        async execute(_input, { signal }) {
          const details = await fetchWebMcpJson(
            detailsUrl,
            isMemberDetails,
            signal,
          );
          return describeMember(details);
        },
        annotations: { readOnlyHint: true, untrustedContentHint: true },
      },
    ]);
  }
</script>
