---
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import SupportPanel from '../components/SupportPanel.astro';
import { eventSlug, formatEventDate, isPastEvent, nextScheduledEvent, sortAscending } from '../lib/events';

const events = (await getCollection('events', ({ data }) => !data.draft)).sort(sortAscending),
 upcoming = events.filter((event) => !isPastEvent(event)),
 nextEvent = nextScheduledEvent(upcoming),
 [site] = await getCollection('site'),
 people = await getCollection('people', ({ data }) => data.published && data.roles.includes('member')),
 partners = await getCollection('partners'),
 faces = people.filter((person) => person.data.image).slice(0, 5);
---

<BaseLayout title={site.data.name} description={site.data.description}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-intro">
        <p class="community-tag"><span aria-hidden="true"></span>La community tech del Nord-Est</p>
        <h1>Le idee migliori<br />nascono insieme.</h1>
        <p class="hero-copy">Il codice è il punto di partenza. Le persone fanno il resto.<br class="desktop-break" /> Incontri gratuiti, esperienze vere e voglia di costruire, dal 2006.</p>
        <div class="hero-actions">
          <a class="button" href={withBase('/eventi/')}>Scopri gli eventi</a>
          <a class="button button-secondary" href={withBase('/chi-siamo/')}>Conosci XE</a>
        </div>
      </div>
      <div class="hero-feature">
        <div class="hero-photo-wrap">
          <img class="hero-photo" src={withBase('/media/1095-xedotnet-04.jpg')} alt="Codice proiettato durante un incontro XeDotNet" width="1920" height="550" fetchpriority="high" />
          <div class="hero-photo-caption"><span>Ci vediamo al prossimo incontro.</span><span>Porta la tua curiosità.</span></div>
        </div>
        <div class="hero-stamp">
          <p>{nextEvent ? 'Il prossimo incontro' : 'Incontri dal 2006'}</p>
          {nextEvent ? (
            <>
              <time datetime={nextEvent.data.date.toISOString()} aria-label={formatEventDate(nextEvent.data.date)}><strong>{new Intl.DateTimeFormat('it-IT', { day: '2-digit', month: 'short', timeZone: 'Europe/Rome' }).format(nextEvent.data.date)}</strong></time>
              <h2><a href={withBase(`/eventi/${eventSlug(nextEvent)}/`)}>{nextEvent.data.title}</a></h2>
              {nextEvent.data.venue && <p class="hero-venue">{nextEvent.data.venue.name}</p>}
              <a class="event-details-link" href={withBase(`/eventi/${eventSlug(nextEvent)}/`)}>Programma e dettagli <span aria-hidden="true">↗</span></a>
            </>
          ) : (
            <><strong>{events.length}</strong><p>eventi e una community in continuo movimento.</p></>
          )}
        </div>
      </div>
    </div>
    <div class="shell community-strip">
      <p>Una passione condivisa, tante strade per incontrarsi.</p>
      <div class="community-formats"><span>Tech-Pub</span><span>Workshop</span><span>Conferenze</span><span>Online meeting</span></div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading"><h2>Prossimi eventi</h2><a href={withBase('/eventi/')}>Calendario completo</a></div>
    {upcoming.length ? (
      <ol class="event-list event-grid">{upcoming.slice(0, 3).map((event) => <li><EventCard event={event} featured={event.id === nextEvent?.id} /></li>)}</ol>
    ) : (
      <p>Stiamo preparando i prossimi incontri. Iscriviti alla newsletter per ricevere gli aggiornamenti.</p>
    )}
  </section>

  <section class="section shell community-section">
    <div class="community-panel">
      <div class="community-message">
        <div class="community-faces" aria-hidden="true">{faces.map((person) => <img src={withBase(person.data.image ?? '')} alt="" width="64" height="64" loading="lazy" />)}</div>
        <h2>Dietro ogni riga di codice,<br />c’è una persona.</h2>
        <p>XE riunisce professionisti, studenti e appassionati. Gli eventi restano gratuiti grazie ai soci che scelgono di sostenerci.</p>
        <a class="button button-secondary" href={withBase('/soci/')}>Conosci i {people.length} soci</a>
      </div>
      <div class="community-history">
        <p class="history-line">
          <span class="history-from">Dal</span>{' '}
          <span class="history-year">2006</span>{' '}
          <span class="history-to">ad oggi</span>{' '}
          <span class="history-break" aria-hidden="true"></span>
          <span class="history-dot" aria-hidden="true">&middot;</span>{' '}
          <span class="history-action">per crescere insieme.</span>
        </p>
        <p>Esplora gli incontri, i materiali e le idee che hanno fatto la storia di XE.</p>
        <a href={withBase('/eventi/')}>Esplora il nostro archivio</a>
      </div>
    </div>
    <div class="sponsor-strip">
        <p>Insieme a chi crede nella condivisione</p>
        <ul class="partners" role="list">
          {partners.filter((partner) => partner.data.kind === 'sponsor').map((partner) => <li><a href={partner.data.url} rel="noreferrer">{partner.data.name}</a></li>)}
        </ul>
    </div>
  </section>

  <section class="section shell">
    <SupportPanel membershipButtonId={site.data.membershipButtonId} donationButtonId={site.data.donationButtonId} />
  </section>
</BaseLayout>
