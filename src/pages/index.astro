---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import SupportPanel from '../components/SupportPanel.astro';
import { isPastEvent, sortAscending } from '../lib/events';

const events = (await getCollection('events', ({ data }) => !data.draft)).sort(sortAscending);
const upcoming = events.filter((event) => !isPastEvent(event));
const nextEvent = upcoming[0];
const [site] = await getCollection('site');
const people = await getCollection('people', ({ data }) => data.published && data.roles.includes('member'));
const partners = await getCollection('partners');
---

<BaseLayout title={site.data.name} description={site.data.description}>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <h1>La tecnologia cresce quando la condividiamo.</h1>
        <p class="hero-copy">Dal 2006 portiamo nel Nord-Est incontri gratuiti, idee concrete e persone curiose di costruire software migliore.</p>
        <a class="button" href="/eventi/">Scopri gli eventi</a>
      </div>
      <div class="hero-feature">
        <img class="hero-photo" src="/media/1095-xedotnet-04.jpg" alt="Codice proiettato durante un incontro XeDotNet" width="1920" height="550" fetchpriority="high" />
        <div class="hero-stamp">
          <p>{nextEvent ? 'Il prossimo incontro' : 'Incontri dal 2006'}</p>
          {nextEvent ? (
            <>
              <strong>{new Intl.DateTimeFormat('it-IT', { day: '2-digit', month: 'short', timeZone: 'Europe/Rome' }).format(nextEvent.data.date)}</strong>
              <p><a href={`/eventi/${nextEvent.id}/`}>{nextEvent.data.title}</a></p>
            </>
          ) : (
            <><strong>{events.length}</strong><p>eventi e una community in continuo movimento.</p></>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading"><h2>Prossimi eventi</h2><a href="/eventi/">Calendario completo</a></div>
    {upcoming.length ? (
      <ol class="event-list">{upcoming.slice(0, 4).map((event) => <li><EventCard event={event} featured={event.id === nextEvent?.id} /></li>)}</ol>
    ) : (
      <p>Stiamo preparando i prossimi incontri. Iscriviti alla newsletter per ricevere gli aggiornamenti.</p>
    )}
  </section>

  <section class="section surface">
    <div class="shell detail-grid">
      <div>
        <h2>Una community fatta da persone</h2>
        <p>XE riunisce professionisti, studenti e appassionati. Gli eventi restano gratuiti grazie ai soci che scelgono di sostenerci.</p>
        <a class="button button-secondary" href="/soci/">Conosci i {people.length} soci</a>
      </div>
      <div>
        <h2>Con il sostegno di</h2>
        <ul class="partners" role="list">
          {partners.filter((partner) => partner.data.kind === 'sponsor').map((partner) => <li><a href={partner.data.url} rel="noreferrer">{partner.data.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section shell">
    <SupportPanel membershipButtonId={site.data.membershipButtonId} donationButtonId={site.data.donationButtonId} />
  </section>
</BaseLayout>
