---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { eventSlug, formatCalendarDate } from '../../../lib/events';
import { recentEventsForPerson } from '../../../lib/people';
import { initials, markdownExcerpt } from '../../../lib/text';
import { externalLinkProps, isExternalUrl, withBase } from '../../../lib/urls';

const siteOrigin = Astro.site?.origin;

export async function getStaticPaths() {
  const members = await getCollection(
    'people',
    ({ data }) => data.published && data.roles.includes('member'),
  );
  return members.map((member) => ({ params: { slug: member.id }, props: { member } }));
}

const { member } = Astro.props;
const { Content } = await render(member);
const description = markdownExcerpt(member.body ?? '') || `${member.data.name}, socio di XeDotNet.`;
const events = await getCollection('events', ({ data }) => !data.draft);
const recentEvents = recentEventsForPerson(member, events, 3);
const links = [
  ...(member.data.profileUrl ? [{ label: 'Profilo personale', url: member.data.profileUrl }] : []),
  ...member.data.links,
].filter((link, index, all) => all.findIndex((item) => item.url === link.url) === index);
const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: member.data.name,
  url: new URL(withBase(`/soci/${member.id}/`), Astro.site).href,
  ...(member.data.title ? { jobTitle: member.data.title } : {}),
  ...(links.length > 0 ? { sameAs: links.map((link) => link.url) } : {}),
};
---

<BaseLayout title={member.data.name} description={description} type="article" structuredData={personStructuredData}>
  <header class="page-hero soci-hero soci-detail-hero">
    <div class="shell">
      <p class="breadcrumbs"><a href={withBase('/')}>Home</a> / <a href={withBase('/soci/')}>Soci</a> / {member.data.name}</p>
      <p class="soci-overline">{member.data.roles.includes('speaker') ? 'Socio e speaker' : 'Socio di XeDotNet'}</p>
      <h1>{member.data.name}</h1>
      {member.data.title && <p class="soci-subtitle">{member.data.title}</p>}
    </div>
  </header>

  <div class="section shell soci-detail">
    <div class="person-profile">
      <figure class="soci-portrait">
        {member.data.image ? (
          <img src={withBase(member.data.image)} alt={`Ritratto di ${member.data.name}`} width="600" height="600" />
        ) : (
          <span class="soci-initials" aria-hidden="true">{initials(member.data.name)}</span>
        )}
      </figure>
      <div class="soci-story">
        <article class="prose"><Content /></article>
        {links.length > 0 && (
          <section class="soci-links" aria-labelledby="soci-links-h">
            <h2 id="soci-links-h">Collegamenti</h2>
            <ul>
              {links.map((link) => (
                <li>
                  <a href={link.url} {...externalLinkProps(link.url, siteOrigin)}>
                    {link.label}<span aria-hidden="true"> ↗</span>
                    {isExternalUrl(link.url, siteOrigin) && <span class="visually-hidden"> (si apre in una nuova scheda)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    {recentEvents.length > 0 && (
      <section class="soci-events" aria-labelledby="soci-events-h">
        <h2 id="soci-events-h">Eventi con {member.data.name}</h2>
        <ul>
          {recentEvents.map((event) => (
            <li>
              <time datetime={event.data.date.toISOString()}>{formatCalendarDate(event.data.date)}</time>
              <a href={withBase(`/eventi/${eventSlug(event)}/`)}>{event.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <p class="soci-back"><a href={withBase('/soci/')}>Torna a tutti i soci</a></p>
  </div>
</BaseLayout>
