---
import { externalLinkProps, isExternalUrl, withBase } from '../../../lib/urls';
const siteOrigin = Astro.site?.origin;
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { initials, markdownExcerpt } from '../../../lib/text';

export async function getStaticPaths() {
  const members = await getCollection('people', ({ data }) => data.published && data.roles.includes('member'));
  return members.map((member) => ({ params: { slug: member.id }, props: { member } }));
}
const { member } = Astro.props,
 { Content } = await render(member),
 description = markdownExcerpt(member.body ?? '') || `${member.data.name}, socio di XeDotNet.`;
---

<BaseLayout title={member.data.name} description={description}>
  <header class="page-hero"><div class="shell"><p class="breadcrumbs"><a href={withBase('/')}>Home</a> / <a href={withBase('/soci/')}>Soci</a> / {member.data.name}</p><h1>{member.data.name}</h1>{member.data.title && <p>{member.data.title}</p>}</div></header>
  <article class="section shell person-profile">
    <div>{member.data.image ? <img class="person-photo" src={withBase(member.data.image)} alt={`Ritratto di ${member.data.name}`} width="600" height="450" /> : <span class="person-placeholder" aria-hidden="true">{initials(member.data.name)}</span>}</div>
    <div class="prose">
      <Content />
      {member.data.links.length > 0 && <><h2>Collegamenti</h2><ul>{member.data.links.map((link) => <li><a href={link.url} {...externalLinkProps(link.url, siteOrigin, 'me noreferrer')}>{link.label}{isExternalUrl(link.url, siteOrigin) && <span class="visually-hidden"> (si apre in una nuova scheda)</span>}</a></li>)}</ul></>}
      <p><a href={withBase('/soci/')}>Torna all’elenco dei soci</a></p>
    </div>
  </article>
</BaseLayout>
