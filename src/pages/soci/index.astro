---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { groupByInitial } from '../../lib/people';
import { initials } from '../../lib/text';
import { withBase } from '../../lib/urls';

const members = (
  await getCollection('people', ({ data }) => data.published && data.roles.includes('member'))
).sort((a, b) => a.data.sortName.localeCompare(b.data.sortName, 'it'));
const bands = groupByInitial(members);
---

<BaseLayout title="Soci" description="Le persone che sostengono XeDotNet e rendono possibili le attività della community.">
  <header class="page-hero soci-hero">
    <div class="shell">
      <p class="breadcrumbs"><a href={withBase('/')}>Home</a> / Soci</p>
      <h1>Soci</h1>
      <p>Le persone che rendono possibili gli eventi e le attività della community.</p>
    </div>
  </header>

  <div class="section shell soci-directory" id="elenco-soci">
    <div class="soci-directory-heading">
      <h2>Le persone di XE</h2>
      <p>{members.length} {members.length === 1 ? 'socio' : 'soci'} in ordine alfabetico</p>
    </div>
    <nav class="soci-letters" aria-label="Salto per iniziale">
      {bands.map((band) => <a href={`#lettera-${band.letter}`}>{band.letter}</a>)}
    </nav>

    {bands.map((band) => (
      <section class="soci-band" id={`lettera-${band.letter}`} aria-labelledby={`lettera-${band.letter}-h`}>
        <h3 id={`lettera-${band.letter}-h`}>{band.letter}</h3>
        <ul class="soci-list">
          {band.items.map((member) => (
            <li>
              <a class="soci-person" href={withBase(`/soci/${member.id}/`)}>
                {member.data.image ? (
                  <img src={withBase(member.data.image)} alt="" width="96" height="96" loading="lazy" />
                ) : (
                  <span class="soci-initials" aria-hidden="true">{initials(member.data.name)}</span>
                )}
                <span class="soci-person-copy">
                  <strong>{member.data.name}</strong>
                  {member.data.title && <span>{member.data.title}</span>}
                </span>
                {member.data.roles.includes('speaker') && <span class="soci-role">Speaker</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
