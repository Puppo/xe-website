---
import { withBase } from '../../../lib/urls';
import { getCollection, getEntries, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EventCard from '../../../components/EventCard.astro';
import WebMcpEventCatalog from '../../../components/WebMcpEventCatalog.astro';
import WebMcpEventDetails from '../../../components/WebMcpEventDetails.astro';
import { eventSlug, eventStructuredStatus, eventYear, formatEventDate, isCancelled, registrationMessage, registrationState, sortDescending } from '../../../lib/events';
import type { EventEntry } from '../../../lib/events';
import { initials } from '../../../lib/text';

type Props =
  | { kind: 'year'; year: number; events: EventEntry[] }
  | { kind: 'event'; event: EventEntry };

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft),
   years = [...new Set(events.map(eventYear))];
  return [
    ...events.map((event) => ({ params: { slug: eventSlug(event) }, props: { event, kind: 'event' as const } })),
    ...years.map((year) => ({
      params: { slug: String(year) },
      props: { events: events.filter((event) => eventYear(event) === year).sort(sortDescending), kind: 'year' as const, year }
    }))
  ];
}

const props = Astro.props as Props;
let Content: Awaited<ReturnType<typeof render>>['Content'] | undefined;
if (props.kind === 'event') {({ Content } = await render(props.event));}
const event = props.kind === 'event' ? props.event : undefined,
 speakerReferences = event
  ? event.data.sessions.flatMap(({ speakers }) => speakers.flatMap((speaker) => typeof speaker === 'string' ? [] : [speaker.person]))
  : [],
 referencedPeople = await getEntries(speakerReferences),
 peopleById = new Map(referencedPeople.map((person) => [person.id, person]));

interface SpeakerView {
  name: string;
  image?: string;
  href?: string;
  external: boolean;
}

function speakerView(speaker: EventEntry['data']['sessions'][number]['speakers'][number]): SpeakerView {
  if (typeof speaker === 'string') {return { name: speaker, external: false };}
  const person = peopleById.get(speaker.person.id) as CollectionEntry<'people'>,
   internalHref = person.data.published && person.data.roles.includes('member')
    ? withBase(`/soci/${person.id}/`)
    : undefined;
  return {
    external: Boolean(person.data.profileUrl),
    href: person.data.profileUrl ?? internalHref,
    image: person.data.image,
    name: person.data.name
  };
}

const currentRegistrationState = event ? registrationState(event) : undefined,
 eventStructuredData = event ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  description: event.data.description,
  endDate: event.data.endDate?.toISOString(),
  eventAttendanceMode: event.data.venue?.online ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: eventStructuredStatus(event),
  location: event.data.venue ? { '@type': event.data.venue.online ? 'VirtualLocation' : 'Place', name: event.data.venue.name, url: event.data.venue.url } : undefined,
  name: event.data.title,
  startDate: event.data.date.toISOString(),
  url: new URL(withBase(`/eventi/${eventSlug(event)}/`), Astro.site).href
} : undefined,
 webMcpEventDetails = event ? {
  date: formatEventDate(event.data.date),
  description: event.data.description,
  endDate: event.data.endDate ? formatEventDate(event.data.endDate) : undefined,
  eventType: event.data.eventType,
  materials: event.data.materials,
  registration: {
    message: registrationMessage(event),
    url: currentRegistrationState === 'open' ? event.data.registration.url : undefined
  },
  sessions: event.data.sessions.map((session) => ({
    speakers: session.speakers.map((speaker) => speakerView(speaker).name),
    time: session.time,
    title: session.title
  })),
  status: event.data.status,
  title: event.data.title,
  url: new URL(withBase(`/eventi/${eventSlug(event)}/`), Astro.site).href,
  venue: event.data.venue?.name
} : undefined;
---

{props.kind === 'year' ? (
  <BaseLayout title={`Eventi ${props.year}`} description={`Archivio degli eventi XeDotNet organizzati nel ${props.year}.`}>
    <WebMcpEventCatalog events={props.events} />
    <header class="page-hero"><div class="shell"><p class="breadcrumbs"><a href={withBase('/')}>Home</a> / <a href={withBase('/eventi/')}>Eventi</a> / {props.year}</p><h1>Eventi del {props.year}</h1><p>{props.events.length} {props.events.length === 1 ? 'appuntamento' : 'appuntamenti'} nell’archivio XE.</p></div></header>
    <section class="section shell"><ol class="event-list">{props.events.map((item) => <li><EventCard event={item} /></li>)}</ol></section>
  </BaseLayout>
) : event && Content ? (
  <BaseLayout title={event.data.title} description={event.data.description} image={event.data.image} type="article" structuredData={eventStructuredData}>
    {webMcpEventDetails && <WebMcpEventDetails details={webMcpEventDetails} />}
    <header class="page-hero">
      <div class="shell">
        <p class="breadcrumbs"><a href={withBase('/')}>Home</a> / <a href={withBase('/eventi/')}>Eventi</a> / {eventYear(event)}</p>
        {isCancelled(event) && <p class="event-status event-status-detail">Evento annullato</p>}
        <h1>{event.data.title}</h1>
        <p>{formatEventDate(event.data.date)}</p>
      </div>
    </header>
    <div class="section shell detail-grid">
      <article>
        <div class="prose"><Content /></div>
        {event.data.sessions.length > 0 && (
          <section class="section-tight">
            <h2>Programma</h2>
            <ol class="agenda">
              {event.data.sessions.map((session) => (
                <li class="session">
                  <div class="session-time">{session.time || 'Orario da definire'}</div>
                  <div>
                    <h3>{session.title}</h3>
                    {session.speakers.length > 0 && (
                      <ul class="session-speakers" aria-label="Speaker">
                        {session.speakers.map((speaker) => {
                          const profile = speakerView(speaker);
                          const content = <>
                            {profile.image
                              ? <img class="speaker-photo" src={withBase(profile.image)} alt="" width="64" height="64" loading="lazy" decoding="async" />
                              : <span class="speaker-placeholder" aria-hidden="true">{initials(profile.name)}</span>}
                            <strong>{profile.name}</strong>
                          </>;
                          return <li>{profile.href
                            ? <a class="speaker-link" href={profile.href} target="_blank" rel={profile.external ? 'noreferrer' : 'noopener'}>
                                {content}<span class="visually-hidden"> (si apre in una nuova scheda)</span>
                              </a>
                            : <span class="speaker-identity">{content}</span>}</li>;
                        })}
                      </ul>
                    )}
                    {session.description && <p>{session.description}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
        {event.data.materials.length > 0 && <section><h2>Materiali</h2><ul>{event.data.materials.map((material) => <li><a href={material.url} rel="noreferrer">{material.label}</a></li>)}</ul></section>}
      </article>
      <aside class="detail-aside">
        <h2>Dettagli</h2>
        <dl>
          <div><dt>Data</dt><dd>{formatEventDate(event.data.date)}</dd></div>
          {event.data.eventType && <div><dt>Tipo</dt><dd>{event.data.eventType}</dd></div>}
          {event.data.venue && <div><dt>Luogo</dt><dd>{event.data.venue.url ? <a href={event.data.venue.url} rel="noreferrer">{event.data.venue.name}</a> : event.data.venue.name}</dd></div>}
        </dl>
        <div class="registration">
          <h2>Iscrizione</h2>
          <p>{registrationMessage(event)}</p>
          {currentRegistrationState === 'open' && event.data.registration.url && <a class="button" href={event.data.registration.url} target="_blank" rel="noreferrer">{event.data.registration.label ?? 'Iscriviti all’evento'}<span class="visually-hidden"> (si apre in una nuova scheda)</span></a>}
        </div>
      </aside>
    </div>
  </BaseLayout>
) : null}
