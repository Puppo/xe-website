---
import { withBase } from '../../lib/urls';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { eventYear, isPastEvent, sortAscending, sortDescending } from '../../lib/events';

const events = await getCollection('events', ({ data }) => !data.draft),
 upcoming = events.filter((event) => !isPastEvent(event)).sort(sortAscending),
 past = events.filter((event) => isPastEvent(event)).sort(sortDescending),
 years = [...new Set(past.map(eventYear))].sort((a, b) => b - a),
 counts = new Map(years.map((year) => [year, past.filter((event) => eventYear(event) === year).length]));
---

<BaseLayout title="Eventi" description="Prossimi appuntamenti e archivio degli eventi organizzati da XeDotNet.">
  <header class="page-hero"><div class="shell"><p class="breadcrumbs"><a href={withBase('/')}>Home</a> / Eventi</p><h1>Eventi</h1><p>Incontri gratuiti per imparare, confrontarsi e far circolare idee utili.</p></div></header>
  <section class="section shell">
    <div class="section-heading">
      <h2>Prossimi appuntamenti</h2>
      <a class="rss-feed-link" href={withBase('/rss.xml')} type="application/rss+xml">
        <span class="rss-feed-copy"><span class="rss-feed-label">Segui via RSS</span>{' '}<span class="rss-feed-meta">Feed XML degli eventi</span></span>
        <span class="rss-feed-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" /></svg></span>
      </a>
    </div>
    {upcoming.length ? <ol class="event-list">{upcoming.map((event) => <li><EventCard event={event} /></li>)}</ol> : <p>Non ci sono ancora nuovi appuntamenti in calendario. Torna presto, segui il <a href={withBase('/rss.xml')} type="application/rss+xml">feed RSS</a> o iscriviti alla newsletter.</p>}
  </section>
  <section class="section surface">
    <div class="shell">
      <div class="section-heading"><h2 id="archivio">Archivio</h2><p>{past.length} eventi</p></div>
      <ul class="year-grid" role="list">
        {years.map((year) => <li><a href={withBase(`/eventi/${year}/`)}><strong>{year}</strong><span>{counts.get(year)} {counts.get(year) === 1 ? 'evento' : 'eventi'}</span></a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
