{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".astro",
    "playwright-report",
    "test-results",
    "coverage",
    "schemas",
    "**/*.astro"
  ]
}