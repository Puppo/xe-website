SITE_URL=https://www.xedotnet.org/
# When set, the site renders `<meta name="robots" content="noindex, nofollow">`
# on every page and serves `Disallow: /` from /robots.txt. The PR preview
# workflow sets this to `1` for Netlify preview builds; production leaves it
# unset.
PUBLIC_NOINDEX=0
