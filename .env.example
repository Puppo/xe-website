PUBLIC_CONTACT_FORM_ACTION=https://formspree.io/f/INSERIRE_ID
SITE_URL=https://www.xedotnet.org/
# When set, the site renders `<meta name="robots" content="noindex, nofollow">`
# on every page and serves `Disallow: /` from /robots.txt. The Netlify
# integration sets this to `1` automatically for Deploy Previews via
# `netlify.toml`'s `[context.deploy-preview.environment]` block; production
# leaves it unset.
PUBLIC_NOINDEX=0
