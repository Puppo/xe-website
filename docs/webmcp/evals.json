            "text": "Prima parte.",
            "offset": 0,
            "total": 26,
            "nextOffset": 12
          }
        }
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_member",
        "arguments": {
          "slug": "emanuele-furlan",
          "section": "biography",
          "offset": 12
        },
        "mockOutput": {
          "slug": "emanuele-furlan",
          "section": "biography",
          "text": "Seconda parte.",
          "offset": 12,
          "total": 26,
          "nextOffset": null
        }
      }
    ]
  },
  {
    "name": "Retry after a transient catalog error",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Trova i materiali di App modernization."
      },
      {
        "role": "model",
