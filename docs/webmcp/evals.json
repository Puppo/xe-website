[
  {
    "name": "Find a person and read their profile",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Trova Emanuele Furlan e raccontami il suo profilo."
      }
    ],
    "expectedCall": [
      {
        "functionName": "list_members",
        "arguments": {
          "query": "Emanuele Furlan"
        },
        "mockOutput": {
          "members": [
            {
              "slug": "emanuele-furlan",
              "name": "Emanuele Furlan"
            }
          ],
          "offset": 0,
          "total": 1,
          "nextOffset": null
        }
      },
      {
        "functionName": "get_member",
        "arguments": {
          "slug": "emanuele-furlan"
        },
        "mockOutput": {
          "slug": "emanuele-furlan",
          "name": "Emanuele Furlan",
          "url": "https://www.xedotnet.org/soci/emanuele-furlan/",
          "biography": "Sviluppatore e relatore della community XE.",
          "biographyLength": 41,
          "roles": ["member", "speaker"]
        }
      }
    ]
  },
  {
    "name": "Find materials by topic without opening them",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Trova i materiali di App modernization."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_event_materials",
        "arguments": {
          "query": {
            "$pattern": "[Aa]pp.*modernization|modernizzazione"
          }
        },
        "mockOutput": {
          "materials": [
            {
              "label": "Slide",
              "url": "https://example.com/app-modernization/slides",
              "eventSlug": "one-day-app-modernization",
              "eventTitle": "App modernization",
              "sessions": ["Modernizzare le applicazioni"]
            }
          ],
          "offset": 0,
          "total": 1,
          "nextOffset": null
        }
      }
    ]
  },
  {
    "name": "Continue reading a long biography",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Leggi tutta la biografia di Emanuele Furlan."
      },
      {
        "role": "model",
        "type": "functioncall",
        "name": "get_member",
        "arguments": {
          "slug": "emanuele-furlan",
          "section": "biography"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "get_member",
